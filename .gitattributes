# Normalize line endings so Windows checkouts don't produce noisy LF<->CRLF diffs.
# Text files are stored as LF in the repo; Git handles the working-copy form.
* text=auto eol=lf

# Keep shell/batch scripts in their native ending.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf

# Binary assets: never touch.
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.cur   binary
*.ani   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.exe   binary
*.zip   binary
*.mov   binary
*.mp4   binary
